<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/clipSongTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:textStyle="bold"
        android:paddingBottom="12dp" />

    <EditText
        android:id="@+id/clipName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/clip_name_hint"
        android:inputType="text"
        android:paddingBottom="12dp" />

    <TextView
        android:id="@+id/clipStartLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/clip_start" />

    <SeekBar
        android:id="@+id/clipStartSeek"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/clipEndLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/clip_end" />

    <SeekBar
        android:id="@+id/clipEndSeek"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="8dp">

        <Button
            android:id="@+id/clipSetStart"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/clip_set_start" />

        <Button
            android:id="@+id/clipSetEnd"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/clip_set_end" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="8dp">

        <Button
            android:id="@+id/clipPreview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/clip_play" />

        <Button
            android:id="@+id/clipSave"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/clip_save" />
    </LinearLayout>

    <Button
        android:id="@+id/clipDelete"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/clip_delete" />

</LinearLayout>
